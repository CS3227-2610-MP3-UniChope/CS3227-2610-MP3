+    var limited = assertThrows(ApiFailure.class, () -> a.admit(AiKeySlot.STUDENT, actor, AiTask.STUDENT_AGENDA, 100));
+    assertEquals("AI_RATE_LIMITED", limited.code()); assertEquals(298, retrySeconds(limited));

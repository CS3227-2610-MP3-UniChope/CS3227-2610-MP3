+const zone = 'Asia/Singapore';
+export function sgtDate(value = new Date().toISOString()) { return new Intl.DateTimeFormat('en-CA', { timeZone: zone, year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date(value)); }

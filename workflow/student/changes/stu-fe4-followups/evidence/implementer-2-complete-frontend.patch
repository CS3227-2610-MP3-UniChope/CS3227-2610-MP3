+import { expect, test, type Page } from '@playwright/test';
+import { audit } from './contrast-audit';
+
+const moduleId = '20000000-0000-4000-8000-000000000001';
+const slot = { id: '30000000-0000-4000-8000-000000000001', moduleId, moduleCode: 'CS3227', moduleName: 'Software Architecture', tutorName: 'Contrast Synthetic Tutor', startTime: '2026-10-21T02:00:00Z', endTime: '2026-10-21T03:00:00Z' };
+async function fixture(page: Page, state: string) {
+  await page.route('**/api/**', async route => {
+    const path = new URL(route.request().url()).pathname;
+    let status = 200; let body: unknown;
+    if (path === '/api/auth/me') {
+      status = state === 'login' ? 401 : state === 'failure' ? 503 : 200;
+      body = status === 200 ? { id: '10000000-0000-4000-8000-000000000001', name: 'Contrast Synthetic Student', role: state === 'tutor' ? 'TUTOR' : state === 'admin' ? 'ADMIN' : 'STUDENT' } : { code: status === 401 ? 'UNAUTHENTICATED' : 'TEMPORARILY_UNAVAILABLE', requestId: 'contrast' };
+    } else if (path === '/api/auth/csrf') body = { headerName: 'X-TEST', token: 'test-only' };
+    else if (path === '/api/student/modules') body = [{ id: moduleId, code: slot.moduleCode, name: slot.moduleName }];
+    else if (path === '/api/student/slots') body = [slot];
+    else if (path === '/api/student/bookings') body = [{ ...slot, id: '40000000-0000-4000-8000-000000000001', slotId: slot.id, status: 'ACTIVE', cancellable: true }];
+    else { status = 404; body = { code: 'NOT_FOUND' }; }
+    await route.fulfill({ status, contentType: 'application/json', body: JSON.stringify(body) });
+  });
+}
+for (const [state, width] of [['login',1440],['slots',1440],['slots',320],['bookings',1440],['dialog',1440],['tutor',1440],['admin',1440],['failure',1440],['notfound',1440]] as const) {
+  test(`FE-UI-CONTRAST ${state} ${width}px text, controls, selected and keyboard focus`, async ({ page }) => {
+    await page.emulateMedia({ reducedMotion: 'reduce' });
+    await page.setViewportSize({ width, height: 1000 }); await fixture(page, state);
+    const path = state === 'login' ? '/login' : state === 'tutor' || state === 'admin' ? '/' + state : state === 'notfound' ? '/unknown' : state === 'bookings' ? '/student/bookings' : '/student/slots?week=2026-10-19';
+    await page.goto(path); await expect(page.getByRole('heading', { level: 1 })).toBeVisible();
+    if (state === 'slots' || state === 'dialog') await expect(page.getByText(slot.tutorName)).toBeVisible();
+    if (state === 'bookings') await expect(page.getByRole('button', { name: /^cancel(?: booking)?$/i })).toBeVisible();
+    if (state === 'failure') await expect(page.getByRole('alert')).toBeVisible();
+    if (state === 'dialog') { await page.getByRole('button', { name: /^book$/i }).click(); await expect(page.getByRole('dialog')).toBeVisible(); }
+    const text = await audit(page, 'text'); expect(text.checked).toBeGreaterThan(0); expect.soft(text.failures, 'all visible text').toEqual([]);
+    const controls = await audit(page, 'controls'); expect.soft(controls.failures, 'control and selected boundaries').toEqual([]);
+    // Visit the complete keyboard cycle, including the skip link; dialog cycling
+    // is scoped by its focus trap. Audit text again in each focus-visible state.
+    const count = await page.locator(state === 'dialog' ? '[role="dialog"] button' : 'a[href],button,input,select,textarea').count();
+    let focused = 0;
+    for (let index = 0; index < count + 1; index++) {
+      await page.keyboard.press('Tab');
+      const focus = await audit(page, 'focus'); focused += focus.checked;
+      expect.soft(focus.failures, 'keyboard focus').toEqual([]);
+      expect.soft((await audit(page, 'text')).failures, 'focused text').toEqual([]);
+    }
+    expect(focused).toBeGreaterThan(0);
+  });
+}

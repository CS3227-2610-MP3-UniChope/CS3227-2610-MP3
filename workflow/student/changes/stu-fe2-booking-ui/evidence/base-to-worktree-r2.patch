+﻿:root {
+  --ink: #252d3a; --muted: #657084; --surface: #ffffff; --canvas: #f5f6f8;
+  --line: #dde1e7; --soft-line: #e9ecf0; --accent: #b44320; --accent-hover: #943418;
+  --accent-soft: #fff2eb; --success: #276442; --danger: #96352c;
+  --radius: .25rem; --bs-body-color: var(--ink); --bs-body-bg: var(--surface);
+  --bs-link-color: var(--accent); --bs-link-hover-color: var(--accent-hover);
+  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+}
+* { box-sizing: border-box; }
+body { margin: 0; color: var(--ink); font-size: .875rem; line-height: 1.6; }
+button, input, select { font: inherit; }
+button, a, input, select { touch-action: manipulation; }
+a { color: var(--accent); text-underline-offset: .2em; }
+h1,h2,h3,p { margin-top: 0; }
+h1 { font-size: 1.875rem; letter-spacing: -.04em; font-weight: 650; line-height: 1.2; margin-bottom: .75rem; }
+h2 { font-size: 1.125rem; font-weight: 600; }
+h3 { font-size: .875rem; font-weight: 600; }
+:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
+.muted, .quiet { color: var(--muted); }.small { font-size: .75rem; }
+.eyebrow { display: block; color: var(--muted); font-size: .625rem; letter-spacing: .14em; font-weight: 700; margin-bottom: .75rem; }
+.skip-link { position: absolute; top: .5rem; left: .5rem; transform: translateY(-200%); padding: .5rem 1rem; background: var(--surface); z-index: 1200; }
+.skip-link:focus { transform: translateY(0); }
+.line-icon { width: 1.25rem; height: 1.25rem; flex-shrink: 0; vertical-align: middle; }
+.brand { display: inline-flex; align-items: center; gap: .625rem; color: var(--ink); font-size: 1.375rem; font-weight: 750; letter-spacing: -.045em; white-space: nowrap; }
+.brand-mark { background: var(--accent); color: white; width: 2rem; height: 2rem; display: inline-flex; align-items: center; justify-content: center; border-radius: .375rem; }

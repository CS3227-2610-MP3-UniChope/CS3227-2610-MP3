+﻿import { useState } from 'react';
+import { ApiError } from './api';
+import { Brand, Icon } from './components';
+export default function Login({ login, message, retryLogout, signingOut = false }: { login: (email: string, password: string) => Promise<void>; message: string; retryLogout?: () => void; signingOut?: boolean }) {
+  const [email, setEmail] = useState(''); const [password, setPassword] = useState('');
+  const [pending, setPending] = useState(false); const [error, setError] = useState(''); const [csrfFailed, setCsrfFailed] = useState(false);
+  async function submit() {
+    if (pending || signingOut) return;
+    setPending(true); setError(''); setCsrfFailed(false);
+    try { await login(email, password); } catch (e) {
+      const failure = e instanceof ApiError ? e : new ApiError();
+      setError(failure.code === 'INVALID_CREDENTIALS' ? 'The email or password is incorrect. Please try again.' : failure.code === 'AUTH_RATE_LIMITED' ? `Too many sign-in attempts. Please wait${/^\d+$/.test(failure.retryAfter) ? ` ${Math.min(Number(failure.retryAfter), 86400)} seconds` : ' a little'} before trying again.` : 'Sign in is temporarily unavailable. Please try again.');
+      setCsrfFailed(true);
+    } finally { setPassword(''); setPending(false); }
+  }
+  return <div className="login-page"><header className="login-header"><Brand /><span className="quiet">Your time, well spent.</span></header>
+    <main id="main-content" tabIndex={-1} className="login-main"><div className="login-intro"><span className="eyebrow">A LITTLE TIME. A LOT OF CLARITY.</span><h2>Make room for<br />your next question.</h2><p>Find a consultation, choose a time, and keep your learning moving.</p><div className="login-note"><Icon name="calendar" /><span>A simpler way to connect<br /><strong>One consultation at a time.</strong></span></div></div>
+      <section className="login-form-panel" aria-labelledby="login-title"><span className="eyebrow">WELCOME TO UNICHOPE</span><h1 id="login-title">Sign in</h1><p className="muted">Your next conversation starts here.</p>
+        {(error || message) && <div role="alert" className="notice error">{error || message}</div>}
+        {retryLogout && <button className="btn btn-outline-secondary mb-3" onClick={retryLogout}>Retry sign out</button>}
+        {signingOut && <p role="status">Signing out of your session…</p>}
+        <form onSubmit={event => { event.preventDefault(); void submit(); }}><label htmlFor="email">Email</label><input className="form-control" id="email" type="email" autoComplete="username" required value={email} onChange={event => setEmail(event.target.value)} disabled={pending || signingOut} />
+          <label htmlFor="password">Password</label><input className="form-control" id="password" type="password" autoComplete="current-password" required value={password} onChange={event => setPassword(event.target.value)} disabled={pending || signingOut} />
+          <button className="btn btn-primary login-submit" disabled={pending || signingOut} type="submit">{pending ? 'Signing in…' : 'Sign in'}<Icon name="arrow" /></button>
+        </form>{csrfFailed && <button className="text-button mt-3" onClick={() => { setError(''); setCsrfFailed(false); document.getElementById('password')?.focus(); }}>Try again</button>}
+        <p className="login-help">Use your UniChope account to continue.</p>
+      </section></main><footer className="login-footer">A dedicated space for better conversations.</footer></div>;
+}
+
diff --git a/src/frontend/src/api.ts b/src/frontend/src/api.ts
new file mode 100644
index 0000000..7017e16
--- /dev/null
+++ b/src/frontend/src/api.ts
@@ -0,0 +1,94 @@
+export type Actor = { id: string; name: string; role: 'STUDENT' | 'TUTOR' | 'ADMIN' };
+export type Module = { id: string; code: string; name: string };
+export type Slot = { id: string; moduleId: string; moduleCode: string; moduleName: string; tutorName: string; startTime: string; endTime: string };
+export type Booking = Slot & { slotId: string; status: 'ACTIVE' | 'CANCELLED' | 'COMPLETED'; cancellable: boolean };
+export class ApiError extends Error {
+  constructor(public status = 0, public code = 'UNAVAILABLE', public retryAfter = '') { super(code); }
+}
+export class StaleRequest extends Error {}
+export const isActor = (value: unknown): value is Actor => {
+  const a = value as Actor | null;
+  return !!a && typeof a.id === 'string' && typeof a.name === 'string' && ['STUDENT', 'TUTOR', 'ADMIN'].includes(a.role);
+};
+export class ApiClient {
+  private generation = 0;
+  private controllers = new Set<AbortController>();
+  private token: { headerName: string; token: string } | null = null;
+  private tokenPromise: Promise<void> | null = null;
+  onSessionError: (error: ApiError) => void = () => {};
+  reset() {
+    this.generation++;
+    this.controllers.forEach(controller => controller.abort());
+    this.controllers.clear(); this.token = null; this.tokenPromise = null;
+  }
+  clearToken() { this.token = null; this.tokenPromise = null; }
+  async csrf() {
+    if (this.token) return;
+    if (!this.tokenPromise) {
+      const generation = this.generation;
+      this.tokenPromise = this.request<unknown>('/api/auth/csrf', undefined, false).then(value => {
+        const t = value as { headerName?: unknown; token?: unknown };
+        if (!t || typeof t.headerName !== 'string' || !/^[!#$%&'*+.^_`|~0-9A-Za-z-]+$/.test(t.headerName) || typeof t.token !== 'string' || !t.token) throw new ApiError();
+        if (generation !== this.generation) throw new StaleRequest();
+        this.token = { headerName: t.headerName, token: t.token };
+      }).finally(() => { if (generation === this.generation) this.tokenPromise = null; });
+    }
+    return this.tokenPromise;
+  }
+  async request<T>(path: string, body?: object, protectedRequest = true): Promise<T> {
+    const generation = this.generation;
+    if (body !== undefined) {
+      try { await this.csrf(); }
+      catch (error) {
+        if (generation !== this.generation) throw new StaleRequest();
+        // Token acquisition is shared with anonymous login/logout. A protected
+        // caller must still honor session revocation before its POST is sent.
+        if (protectedRequest && error instanceof ApiError && (error.status === 401 || error.code === 'ACCOUNT_INACTIVE')) {
+          this.onSessionError(error);
+          if (generation !== this.generation) throw new StaleRequest();
+        }
+        throw error;
+      }
+    }
+    if (generation !== this.generation) throw new StaleRequest();
+    const controller = new AbortController(); this.controllers.add(controller);
+    try {
+      const headers: Record<string, string> = { Accept: 'application/json' };
+      if (body !== undefined) {
+        headers['Content-Type'] = 'application/json';
+        headers[this.token!.headerName] = this.token!.token;
+      }
+      const response = await fetch(path, { method: body === undefined ? 'GET' : 'POST', headers,
+        ...(body === undefined ? {} : { body: JSON.stringify(body) }), credentials: 'same-origin', cache: 'no-store', signal: controller.signal });
+      if (generation !== this.generation) throw new StaleRequest();
+      const expectedStatus = body !== undefined && path === '/api/auth/logout' ? 204 : body !== undefined && path === '/api/student/bookings' ? 201 : 200;
+      if (response.ok && response.status !== expectedStatus) throw new ApiError();
+      if (response.status === 204) return undefined as T;
+      if (!response.headers.get('Content-Type')?.includes('application/json')) throw new ApiError();
+      let value: unknown;
+      try { value = await response.json(); } catch { throw new ApiError(); }
+      if (generation !== this.generation) throw new StaleRequest();
+      if (!response.ok) {
+        const code = value && typeof value === 'object' && 'code' in value && typeof value.code === 'string' ? value.code : 'UNAVAILABLE';
+        const error = new ApiError(response.status, code, response.headers.get('Retry-After') || '');
+        if (code === 'CSRF_INVALID') this.clearToken();
+        if (protectedRequest && (response.status === 401 || code === 'ACCOUNT_INACTIVE')) this.onSessionError(error);
+        throw error;
+      }
+      return value as T;
+    } catch (error) {
+      if (generation !== this.generation || controller.signal.aborted) throw new StaleRequest();
+      throw error instanceof ApiError || error instanceof StaleRequest ? error : new ApiError();
+    } finally { this.controllers.delete(controller); }
+  }
+}
+export function safeError(error: unknown, mutation = false) {
+  const e = error instanceof ApiError ? error : new ApiError();
+  if (e.code === 'CSRF_INVALID') return 'Your security token expired. Retry with a fresh token to continue.';
+  if (e.code === 'FORBIDDEN') return 'Access denied. You do not have permission to view this resource.';
+  if (e.code === 'SLOT_UNAVAILABLE') return 'This slot is no longer available. The list has been refreshed; choose another consultation.';
+  if (e.code === 'BOOKING_OVERLAP') return 'This consultation overlaps another active booking. Choose a different time.';
+  if (e.code === 'NOT_FOUND' || e.code === 'INVALID_STATE') return 'This booking is no longer available for cancellation. The list has been refreshed.';
+  if (mutation) return 'We could not confirm the outcome. The change may have completed. Refresh and check My bookings before trying again.';
+  return 'The service is temporarily unavailable. Please try again.';
+}

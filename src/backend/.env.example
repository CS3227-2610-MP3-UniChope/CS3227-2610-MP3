# UniChope backend settings. Copy to .env and fill in local values; .env is git-ignored.
# Never commit real passwords or SoCLaaS keys. Use separate keys for development and production.
# Note: the backend reads these as environment variables; it does not load .env by itself.

# --- Database (required with the app-api profile) ---
UNICHOPE_JDBC_URL=jdbc:postgresql://127.0.0.1:55433/unichope_manual
UNICHOPE_JDBC_USER=
UNICHOPE_JDBC_PASSWORD=

# --- One-time initial Admin (only for `gradlew bootstrapAdmin`; remove afterwards) ---
UNICHOPE_ADMIN_NAME=
UNICHOPE_ADMIN_EMAIL=
UNICHOPE_ADMIN_PASSWORD=

# --- AI ---
# unavailable (default) | fake (only with the local profile) | shared (real SoCLaaS)
UNICHOPE_AI_MODE=unavailable

# One SoCLaaS key per role (format clsk_<prefix>_<secret>). A missing key disables only that role's AI.
# The SoCLaaS endpoint is fixed in SoCLaaSChatCompletionsProvider and is not configurable.
SOC_LLM_API_KEY_STUDENT=
SOC_LLM_API_KEY_TUTOR=
SOC_LLM_API_KEY_ADMIN=

# Optional. Chat model id (default qwen3.5:9b) and per-key limits per minute.
# SOC_LLM_MODEL=qwen3.5:9b
# SOC_LLM_RPM=80
# SOC_LLM_TPM=160000

# UniChope backend settings. Copy to .env and fill in local values; .env is git-ignored.
# Never commit real passwords or SoCLaaS keys. Use separate keys for development and production.
# Note: the backend reads these as environment variables; it does not load .env by itself.

# --- Database (required with the app-api profile) ---
UNICHOPE_JDBC_URL=jdbc:postgresql://127.0.0.1:55432/mp3_test
UNICHOPE_JDBC_USER=mp3_test
UNICHOPE_JDBC_PASSWORD=change-me

# --- One-time initial Admin (only for `gradlew bootstrapAdmin`; remove afterwards) ---
UNICHOPE_ADMIN_NAME=Admin
UNICHOPE_ADMIN_EMAIL=admin@example.edu
UNICHOPE_ADMIN_PASSWORD=change-me

# --- AI ---
# unavailable (default) | fake (only with the local profile) | shared (real SoCLaaS gateway)
UNICHOPE_AI_MODE=unavailable

# SoCLaaS base URL including /v1
SOC_LLM_API_URL=https://soclaas.example/v1

# One SoCLaaS key per role (format clsk_<prefix>_<secret>). A missing key disables only that role's AI.
SOC_LLM_API_KEY_STUDENT=
SOC_LLM_API_KEY_TUTOR=
SOC_LLM_API_KEY_ADMIN=

# Optional per-key limits. Defaults leave margin under SoCLaaS's 90 rpm, $80/day, $800/month.
# Budgets are in microdollars (1,000,000 = $1).
# SOC_LLM_RPM=80
# SOC_LLM_DAILY_BUDGET=70000000
# SOC_LLM_MONTHLY_BUDGET=700000000

# The model is chosen by an Admin (GET/PUT /api/admin/ai/model); default qwen3.5:9b.
